# ImageMagick 7 with librsvg, as the maintainer's Fedora has it: what the release workflow
# draws the pad glyphs with, since its runner's Ubuntu packages ImageMagick 6.
FROM registry.fedoraproject.org/fedora:44@sha256:8d2d82ab11e614324c42bc1e17322ea7829a8f48faea97645d2fa80d5f56f658
RUN dnf -y install ImageMagick librsvg2 && dnf clean all
ENTRYPOINT ["magick"]
